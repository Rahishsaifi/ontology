# Copy to .env and replace placeholders. Never commit .env.

DEMO_MODE=true
APP_ADMIN_TOKEN=
APP_API_TOKEN=

# memory: no Neo4j required
# neo4j: set NEO4J_* below (local or Aura)
GRAPH_BACKEND=memory

# Live SuccessFactors. Prefer oauth_saml_private_key when you have a registered
# OAuth client private key. Username/password are not required for that method.
SF_BASE_URL=
SF_AUTH_METHOD=oauth_saml_private_key
SF_COMPANY_ID=
SF_CLIENT_ID=
SF_USER_ID=
SF_USER_KEY=
SF_TOKEN_URL=
SF_IDP_URL=
SF_PRIVATE_KEY=
SF_ACCESS_TOKEN=
SF_SAML_ASSERTION=
SF_USERNAME=
SF_PASSWORD=
SF_TIMEOUT_SECONDS=30
SF_MAX_RETRIES=3
SF_PAGE_SIZE=100
SF_ALLOW_INSECURE_HTTP=false
TLS_VERIFY=true

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me

DATA_DIR=./data
SOURCE_SYSTEM=successfactors
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUERY_TIMEOUT_SECONDS=5
QUERY_MAX_ROWS=200
INGESTION_BATCH_SIZE=100
INLINE_JOBS=false
SENSITIVE_PROPERTY_PATTERNS=ssn,nationalid,dateofbirth,password,salary,bankaccount,taxid,passport,iban,compensation
