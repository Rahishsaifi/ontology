# Copy to .env and replace placeholders before any shared deployment.
# Empty API tokens are accepted only while DEMO_MODE=true. The UI then uses
# demo-admin and demo-reader. Set both tokens before exposing the API.

DEMO_MODE=true
APP_ADMIN_TOKEN=
APP_API_TOKEN=

# memory: process-local graph for a credential-free demo.
# neo4j: durable graph. Use this with Docker Compose.
GRAPH_BACKEND=memory

SF_BASE_URL=
SF_AUTH_METHOD=oauth_bearer
SF_ACCESS_TOKEN=
SF_USERNAME=
SF_PASSWORD=
SF_COMPANY_ID=
SF_TOKEN_URL=
SF_CLIENT_ID=
SF_SAML_ASSERTION=
SF_TIMEOUT_SECONDS=30
SF_MAX_RETRIES=3
SF_PAGE_SIZE=100
SF_ALLOW_INSECURE_HTTP=false
TLS_VERIFY=true

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-dev-only

DATA_DIR=./data
SOURCE_SYSTEM=successfactors
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUERY_TIMEOUT_SECONDS=5
QUERY_MAX_ROWS=200
INGESTION_BATCH_SIZE=100
INLINE_JOBS=false
SENSITIVE_PROPERTY_PATTERNS=ssn,nationalid,dateofbirth,password,salary,bankaccount,taxid,passport,iban,compensation
